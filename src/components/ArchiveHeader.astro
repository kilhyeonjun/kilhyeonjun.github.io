---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  count?: number;
  countLabel?: string;
}

const { eyebrow, title, description, count, countLabel = 'entries' } = Astro.props;
---

<header data-archive-header class="border-b border-gray-200 pb-8 dark:border-gray-700 sm:pb-10">
  <p class="font-mono text-xs font-semibold uppercase tracking-[0.1em] text-primary-700 dark:text-primary-300">Archive · {eyebrow}</p>
  <div class="mt-3 grid gap-5 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
    <div>
      <h1 class="text-4xl font-bold tracking-[-0.04em] text-gray-950 dark:text-gray-50 sm:text-5xl">{title}</h1>
      <p class="mt-4 max-w-2xl text-base leading-7 text-gray-600 dark:text-gray-300">{description}</p>
    </div>
    {typeof count === 'number' && (
      <p class="font-mono text-xs uppercase tracking-[0.08em] text-gray-500 dark:text-gray-400">
        <strong class="text-2xl text-gray-900 dark:text-gray-100">{count}</strong> {countLabel}
      </p>
    )}
  </div>
</header>
