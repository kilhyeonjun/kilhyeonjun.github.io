---
import { formatDate } from '../lib/utils';

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  category: string;
  tags: string[];
  slug: string;
}

const { title, description, publishDate, category, tags, slug } = Astro.props;
---

<article data-field-note-row class="group border-b border-gray-200 dark:border-gray-700">
  <a href={`/blog/${slug}/`} class="grid min-h-11 gap-3 py-6 transition sm:grid-cols-[7rem_minmax(0,1fr)_auto] sm:items-start sm:gap-6 sm:py-7">
    <time class="font-mono text-xs tracking-wide text-gray-500 dark:text-gray-400" datetime={publishDate.toISOString()}>
      {formatDate(publishDate)}
    </time>
    <span class="min-w-0">
      <span class="block text-lg font-bold leading-7 tracking-tight text-gray-900 transition group-hover:text-primary-700 dark:text-gray-100 dark:group-hover:text-primary-300 sm:text-xl">{title}</span>
      <span class="mt-2 block text-sm leading-6 text-gray-600 dark:text-gray-300">{description}</span>
      {tags.length > 0 && (
        <span class="mt-3 flex flex-wrap gap-x-3 gap-y-1 font-mono text-[11px] text-gray-500 dark:text-gray-400">
          {tags.slice(0, 3).map((tag) => <span>#{tag}</span>)}
        </span>
      )}
    </span>
    <span class="flex items-center justify-between gap-3 sm:flex-col sm:items-end">
      <span class="rounded-full bg-primary-50 px-3 py-1 text-xs font-semibold text-primary-700 dark:bg-primary-900/30 dark:text-primary-300">{category}</span>
      <span aria-hidden="true" class="text-lg text-gray-400 transition group-hover:translate-x-1 group-hover:text-primary-600 dark:group-hover:text-primary-300">→</span>
    </span>
  </a>
</article>
