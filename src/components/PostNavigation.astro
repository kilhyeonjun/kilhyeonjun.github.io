---
interface Props { prevPost?: { title: string; slug: string } | null; nextPost?: { title: string; slug: string } | null; }
const { prevPost, nextPost } = Astro.props;
---

{(prevPost || nextPost) && (
  <nav data-post-navigation class="mt-12 grid gap-3 border-t border-gray-200 pt-8 dark:border-gray-700 sm:grid-cols-2" aria-label="게시글 네비게이션">
    {prevPost ? <a href={`/blog/${prevPost.slug}/`} class="group flex min-h-28 flex-col justify-between rounded-2xl border border-gray-200 p-5 hover:border-primary-400 dark:border-gray-700 dark:hover:border-primary-500"><span class="font-mono text-[10px] uppercase tracking-[0.08em] text-gray-500 dark:text-gray-400">← Previous note</span><strong class="mt-4 text-sm leading-6 text-gray-900 group-hover:text-primary-700 dark:text-gray-100 dark:group-hover:text-primary-300">{prevPost.title}</strong></a> : <div />}
    {nextPost ? <a href={`/blog/${nextPost.slug}/`} class="group flex min-h-28 flex-col items-end justify-between rounded-2xl border border-gray-200 p-5 text-right hover:border-primary-400 dark:border-gray-700 dark:hover:border-primary-500"><span class="font-mono text-[10px] uppercase tracking-[0.08em] text-gray-500 dark:text-gray-400">Next note →</span><strong class="mt-4 text-sm leading-6 text-gray-900 group-hover:text-primary-700 dark:text-gray-100 dark:group-hover:text-primary-300">{nextPost.title}</strong></a> : <div />}
  </nav>
)}
