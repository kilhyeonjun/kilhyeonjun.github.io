---
---

<button
  id="search-trigger"
  type="button"
  class="rounded-lg p-2.5 text-gray-500 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-700"
  aria-label="검색"
>
  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
  </svg>
</button>

<dialog
  id="search-dialog"
  class="fixed inset-0 z-[100] m-0 h-full max-h-full w-full max-w-full bg-transparent p-0 backdrop:bg-black/50"
>
  <div class="flex h-full items-start justify-center pt-[10vh]" id="search-dialog-backdrop">
    <div class="mx-4 w-full max-w-xl rounded-xl border border-gray-200 bg-white p-4 shadow-2xl dark:border-gray-700 dark:bg-gray-900" id="search-container">
      <div class="mb-2 flex items-center justify-between">
        <span class="text-sm font-medium text-gray-500 dark:text-gray-400">검색</span>
        <kbd class="rounded border border-gray-300 px-1.5 py-0.5 text-xs text-gray-500 dark:border-gray-600 dark:text-gray-400">ESC</kbd>
      </div>
      <div id="pagefind-search"></div>
    </div>
  </div>
</dialog>

<script>
  function initSearch() {
    const trigger = document.getElementById('search-trigger');
    const dialog = document.getElementById('search-dialog') as HTMLDialogElement;
    const backdrop = document.getElementById('search-dialog-backdrop');
    const container = document.getElementById('search-container');
    let searchLoaded = false;

    async function openSearch() {
      dialog?.showModal();
      if (!searchLoaded) {
        searchLoaded = true;
        // @ts-ignore
        const { PagefindUI } = await import('@pagefind/default-ui');
        new PagefindUI({
          element: '#pagefind-search',
          showSubResults: true,
          showImages: false,
        });
      }
      setTimeout(() => {
        const input = document.querySelector<HTMLInputElement>('#pagefind-search input');
        input?.focus();
      }, 100);
    }

    function closeSearch() {
      dialog?.close();
    }

    trigger?.addEventListener('click', openSearch);

    backdrop?.addEventListener('click', (e) => {
      if (!container?.contains(e.target as Node)) {
        closeSearch();
      }
    });

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        if (dialog?.open) {
          closeSearch();
        } else {
          openSearch();
        }
      }
    });
  }

  initSearch();
</script>

<style is:global>
  :root {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: #2563eb;
    --pagefind-ui-text: #1f2937;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: #e5e7eb;
    --pagefind-ui-tag: #f3f4f6;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-font: 'Inter', system-ui, sans-serif;
  }

  .dark {
    --pagefind-ui-primary: #3b82f6;
    --pagefind-ui-text: #f3f4f6;
    --pagefind-ui-background: #111827;
    --pagefind-ui-border: #374151;
    --pagefind-ui-tag: #1f2937;
  }

  /* Pagefind UI overrides */
  .pagefind-ui__search-input {
    width: 100% !important;
    padding: 0.75rem 1rem !important;
    border: 1px solid var(--pagefind-ui-border) !important;
    border-radius: var(--pagefind-ui-border-radius) !important;
    background: var(--pagefind-ui-background) !important;
    color: var(--pagefind-ui-text) !important;
    font-size: 1rem !important;
    outline: none !important;
  }

  .pagefind-ui__search-input:focus {
    border-color: var(--pagefind-ui-primary) !important;
    box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.3) !important;
  }

  .pagefind-ui__search-clear {
    padding: 0.5rem 1rem !important;
    border-radius: 6px !important;
    background: var(--pagefind-ui-tag) !important;
    color: var(--pagefind-ui-text) !important;
    border: none !important;
    cursor: pointer !important;
    font-size: 0.85rem !important;
  }

  .pagefind-ui__result {
    padding: 0.75rem 0 !important;
    border-bottom: 1px solid var(--pagefind-ui-border) !important;
  }

  .pagefind-ui__result-link {
    color: var(--pagefind-ui-primary) !important;
    font-weight: 600 !important;
    text-decoration: none !important;
    font-size: 0.95rem !important;
  }

  .pagefind-ui__result-link:hover {
    text-decoration: underline !important;
  }

  .pagefind-ui__result-excerpt {
    color: var(--pagefind-ui-text) !important;
    opacity: 0.7 !important;
    font-size: 0.85rem !important;
    margin-top: 0.25rem !important;
  }

  .pagefind-ui__results-area {
    margin-top: 0.75rem !important;
    max-height: 50vh !important;
    overflow-y: auto !important;
  }

  .pagefind-ui__message {
    color: var(--pagefind-ui-text) !important;
    opacity: 0.6 !important;
    font-size: 0.85rem !important;
    padding: 1rem 0 !important;
  }

  .pagefind-ui__form::before {
    display: none !important;
  }

  .pagefind-ui__drawer {
    gap: 0 !important;
  }
</style>
