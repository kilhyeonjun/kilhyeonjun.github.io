---
interface Heading { depth: number; slug: string; text: string; }
interface Props { headings: Heading[]; }
const { headings } = Astro.props;
const filteredHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---

{filteredHeadings.length > 0 && (
  <>
    <details class="my-8 rounded-xl border border-gray-200 bg-gray-50/70 px-4 dark:border-gray-700 dark:bg-gray-800/50 lg:hidden">
      <summary class="flex min-h-11 cursor-pointer items-center font-mono text-xs font-semibold uppercase tracking-[0.08em] text-gray-700 dark:text-gray-200">On this page</summary>
      <nav class="border-t border-gray-200 pb-3 pt-2 dark:border-gray-700" aria-label="목차">
        <ul>
          {filteredHeadings.map((heading) => <li class={heading.depth === 3 ? 'pl-4' : ''}><a href={`#${heading.slug}`} class="flex min-h-11 items-center text-sm leading-5 text-gray-600 hover:text-primary-700 dark:text-gray-300 dark:hover:text-primary-300">{heading.text}</a></li>)}
        </ul>
      </nav>
    </details>
    <aside id="toc-sidebar" class="fixed top-24 hidden max-h-[calc(100vh-8rem)] w-56 overflow-y-auto 2xl:block" style="left: calc(50% + 29rem);" aria-label="목차">
      <p class="mb-3 font-mono text-[10px] font-semibold uppercase tracking-[0.1em] text-gray-500 dark:text-gray-400">On this page</p>
      <nav><ul class="border-l border-gray-200 dark:border-gray-700">
        {filteredHeadings.map((heading) => <li><a href={`#${heading.slug}`} data-heading-slug={heading.slug} class:list={['toc-link flex min-h-11 items-center border-l-2 -ml-px text-sm leading-5 transition', heading.depth === 3 ? 'pl-6' : 'pl-4', 'border-transparent text-gray-500 hover:border-gray-400 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-200']}>{heading.text}</a></li>)}
      </ul></nav>
    </aside>
  </>
)}

<script>
  document.addEventListener('astro:page-load', () => {
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc-link')]; if (!links.length) return;
    const headings = links.map((link) => document.getElementById(link.dataset.headingSlug ?? '')).filter(Boolean) as HTMLElement[]; if (!headings.length) return;
    const update = () => {
      const y = window.scrollY + 100; let active = 0;
      for (let index = headings.length - 1; index >= 0; index--) { if (headings[index].offsetTop <= y) { active = index; break; } }
      links.forEach((link, index) => {
        link.classList.toggle('border-primary-500', index === active); link.classList.toggle('text-primary-700', index === active); link.classList.toggle('font-semibold', index === active);
        link.classList.toggle('dark:text-primary-300', index === active); link.classList.toggle('border-transparent', index !== active);
      });
    };
    let ticking = false; const scroll = () => { if (!ticking) requestAnimationFrame(() => { update(); ticking = false; }); ticking = true; };
    window.addEventListener('scroll', scroll); document.addEventListener('astro:before-swap', () => window.removeEventListener('scroll', scroll), { once: true }); update();
  });
</script>
