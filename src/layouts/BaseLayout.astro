---
import '../styles/global.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import { ClientRouter } from 'astro:transitions';
import ThemeToggle from '../components/ThemeToggle.astro';
import SearchDialog from '../components/SearchDialog.astro';

interface Props {
  title: string;
  description?: string;
  lang?: 'ko' | 'en';
  ogImage?: string;
  ogType?: 'website' | 'article';
  canonicalPath?: string;
  noindex?: boolean;
  wide?: boolean;
}

const { title, description = 'Backend Developer 기술 블로그', lang = 'ko', ogImage, ogType = 'website', canonicalPath, noindex = false, wide = false } = Astro.props;
const canonicalURL = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const defaultOgImage = '/og-default.png';
const ogImageURL = new URL(ogImage ?? defaultOgImage, Astro.site).href;
const currentPath = Astro.url.pathname;
const navItems = [
  { href: '/blog/', label: 'Blog', desktop: 'flex' },
  { href: '/categories/', label: 'Categories', desktop: 'hidden md:flex' },
  { href: '/series/', label: 'Series', desktop: 'hidden md:flex' },
  { href: '/tags/', label: 'Tags', desktop: 'hidden md:flex' },
  { href: '/about/', label: 'About', desktop: 'hidden lg:flex' },
];
const isCurrent = (href: string) => currentPath === href || currentPath.startsWith(href);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {import.meta.env.PROD && (
      <meta http-equiv="Content-Security-Policy"
        content="default-src 'self'; script-src 'self' 'unsafe-inline' https://giscus.app https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://giscus.app; font-src 'self' data:; img-src 'self' data:; frame-src https://giscus.app; connect-src 'self';" />
    )}
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="kil-penguin blog RSS" href="/rss.xml" />
    <script src="/legacy-cache-cleanup.js" defer></script>

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      }
    </script>

    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-primary-600 focus:px-4 focus:py-2 focus:text-white">
      본문으로 건너뛰기
    </a>
    <header class="sticky top-0 z-50 border-b border-gray-200 bg-white/80 backdrop-blur-sm dark:border-gray-700 dark:bg-gray-900/80">
      <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:h-[4.5rem]">
        <a href="/" class="flex min-h-11 min-w-11 items-center justify-center gap-2.5 font-bold tracking-tight text-gray-900 dark:text-gray-100 sm:justify-start">
          <span class="grid h-9 w-9 place-items-center rounded-lg bg-gray-900 font-mono text-xs text-white dark:bg-gray-100 dark:text-gray-900">KP</span>
          <span class="hidden leading-tight sm:block">
            KilPenguin
            <small class="block font-mono text-[10px] font-medium uppercase tracking-[0.12em] text-gray-500 dark:text-gray-400">Field Notes</small>
          </span>
        </a>
        <div class="flex items-center gap-1">
          {navItems.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} class:list={[item.desktop, 'min-h-11 items-center rounded-lg px-2 text-sm font-medium transition sm:px-3', isCurrent(item.href) ? 'bg-primary-50 text-primary-700 dark:bg-primary-900/30 dark:text-primary-300' : 'text-gray-600 hover:bg-gray-100 hover:text-primary-600 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-primary-400']}>
              {item.label}
            </a>
          ))}
          <a data-resume-link href="/resume/" class="flex min-h-11 items-center rounded-lg border border-gray-200 px-2 text-sm font-semibold text-gray-700 hover:border-primary-400 hover:text-primary-700 dark:border-gray-700 dark:text-gray-200 dark:hover:border-primary-500 dark:hover:text-primary-300 sm:px-3">
            Resume <span aria-hidden="true" class="ml-1 hidden sm:inline">↗</span>
          </a>
          <details id="mobile-navigation" class="relative md:hidden">
            <summary class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-lg text-gray-500 hover:bg-gray-100 hover:text-primary-700 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-primary-300" aria-label="전체 탐색">
              <svg aria-hidden="true" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
            </summary>
            <nav aria-label="전체 탐색" class="absolute right-0 top-12 z-50 w-56 rounded-xl border border-gray-200 bg-white p-2 shadow-xl dark:border-gray-700 dark:bg-gray-900">
              {navItems.map((item) => (
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} class:list={['flex min-h-11 items-center justify-between rounded-lg px-3 text-sm font-semibold', isCurrent(item.href) ? 'bg-primary-50 text-primary-700 dark:bg-primary-900/30 dark:text-primary-300' : 'text-gray-700 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-800']}>
                  {item.label}{isCurrent(item.href) && <span aria-hidden="true">•</span>}
                </a>
              ))}
            </nav>
          </details>
          <SearchDialog />
          <ThemeToggle />
        </div>
      </nav>
    </header>

    <main id="main-content" class:list={["mx-auto px-4", wide ? "max-w-6xl" : "max-w-4xl py-8"]}>
      <slot />
    </main>

    <footer class="border-t border-gray-200 dark:border-gray-700">
      <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-8 text-sm text-gray-500 dark:text-gray-400 sm:flex-row sm:items-center sm:justify-between">
        <p><strong class="text-gray-700 dark:text-gray-200">KilPenguin</strong> · Backend engineering field notes<br />&copy; {new Date().getFullYear()} KilPenguin</p>
        <div class="flex flex-wrap gap-1 sm:gap-3">
          <a class="inline-flex min-h-11 min-w-11 items-center justify-center px-2 hover:text-primary-600 dark:hover:text-primary-400" href="/about/">About</a>
          <a class="inline-flex min-h-11 min-w-11 items-center justify-center px-2 hover:text-primary-600 dark:hover:text-primary-400" href="https://github.com/kilhyeonjun">GitHub</a>
          <a class="inline-flex min-h-11 min-w-11 items-center justify-center px-2 hover:text-primary-600 dark:hover:text-primary-400" href="/rss.xml">RSS</a>
          <a class="inline-flex min-h-11 min-w-11 items-center justify-center px-2 hover:text-primary-600 dark:hover:text-primary-400" href="/resume/">Resume</a>
        </div>
      </div>
    </footer>
    <script is:inline>
      (function() {
        var MERMAID_CDN = 'https://cdn.jsdelivr.net/npm/mermaid@11.4.1/dist/mermaid.esm.min.mjs';
        var mermaidModule = null;
        var mermaidLoading = null;
        var observer = null;

        function getMermaidTheme() {
          return document.documentElement.classList.contains('dark') ? 'dark' : 'default';
        }

        function preserveSource(blocks) {
          blocks.forEach(function(block) {
            if (!block.getAttribute('data-mermaid-source')) {
              block.setAttribute('data-mermaid-source', block.textContent || '');
            }
          });
        }

        async function restoreAndRender(mod) {
          var blocks = document.querySelectorAll('pre[data-mermaid-source]');
          if (blocks.length === 0) return;

          // Reset each block to original source text (remove prior SVG render)
          blocks.forEach(function(block) {
            block.removeAttribute('data-processed');
            block.textContent = block.getAttribute('data-mermaid-source') || '';
          });

          var isDark = getMermaidTheme() === 'dark';
          mod.default.initialize({
            startOnLoad: false,
            theme: 'base',
            fontFamily: "'Inter', sans-serif",
            themeVariables: isDark ? {
              // Dark mode - blend with gray-900 (#111827) background
              background: '#111827',
              mainBkg: '#1f2937',
              primaryColor: '#1e3a5f',
              primaryTextColor: '#e5e7eb',
              primaryBorderColor: '#374151',
              secondaryColor: '#1e2d3d',
              secondaryTextColor: '#d1d5db',
              secondaryBorderColor: '#374151',
              tertiaryColor: '#1a2332',
              tertiaryTextColor: '#d1d5db',
              tertiaryBorderColor: '#374151',
              lineColor: '#4b5563',
              textColor: '#e5e7eb',
              nodeBorder: '#374151',
              clusterBkg: '#1a1f2e',
              clusterBorder: '#374151',
              titleColor: '#f3f4f6',
              edgeLabelBackground: '#1f2937',
              nodeTextColor: '#e5e7eb',
              // Sequence diagram
              actorBkg: '#1f2937',
              actorBorder: '#374151',
              actorTextColor: '#e5e7eb',
              actorLineColor: '#4b5563',
              signalColor: '#d1d5db',
              signalTextColor: '#e5e7eb',
              labelBoxBkgColor: '#1f2937',
              labelBoxBorderColor: '#374151',
              labelTextColor: '#e5e7eb',
              loopTextColor: '#d1d5db',
              noteBkgColor: '#1e3a5f',
              noteBorderColor: '#2563eb',
              noteTextColor: '#e5e7eb',
              activationBkgColor: '#1e3a5f',
              activationBorderColor: '#60a5fa',
              sequenceNumberColor: '#111827',
              // Flowchart
              fillType0: '#1e3a5f',
              fillType1: '#1e2d3d',
              fillType2: '#2d1f3d',
              fillType3: '#1f332d',
            } : {
              // Light mode - blend with white background
              background: '#ffffff',
              mainBkg: '#eff6ff',
              primaryColor: '#dbeafe',
              primaryTextColor: '#1e3a8a',
              primaryBorderColor: '#93c5fd',
              secondaryColor: '#f0f9ff',
              secondaryTextColor: '#1e40af',
              secondaryBorderColor: '#bfdbfe',
              tertiaryColor: '#f5f3ff',
              tertiaryTextColor: '#4338ca',
              tertiaryBorderColor: '#c4b5fd',
              lineColor: '#6b7280',
              textColor: '#1f2937',
              nodeBorder: '#93c5fd',
              clusterBkg: '#f8fafc',
              clusterBorder: '#bfdbfe',
              titleColor: '#111827',
              edgeLabelBackground: '#ffffff',
              nodeTextColor: '#1f2937',
              // Sequence diagram
              actorBkg: '#dbeafe',
              actorBorder: '#93c5fd',
              actorTextColor: '#1e3a8a',
              actorLineColor: '#6b7280',
              signalColor: '#374151',
              signalTextColor: '#1f2937',
              labelBoxBkgColor: '#eff6ff',
              labelBoxBorderColor: '#93c5fd',
              labelTextColor: '#1f2937',
              loopTextColor: '#374151',
              noteBkgColor: '#fef3c7',
              noteBorderColor: '#f59e0b',
              noteTextColor: '#92400e',
              activationBkgColor: '#dbeafe',
              activationBorderColor: '#3b82f6',
              sequenceNumberColor: '#ffffff',
            },
          });
          for (const block of blocks) {
            const source = block.getAttribute('data-mermaid-source') || '';
            if (!await mod.default.parse(source, { suppressErrors: true })) continue;
            try {
              await mod.default.run({ nodes: [block] });
            } catch {
              block.removeAttribute('data-processed');
              block.textContent = source;
            }
          }
        }

        function setupThemeObserver(mod) {
          if (observer) observer.disconnect();

          var lastTheme = getMermaidTheme();
          observer = new MutationObserver(function() {
            var currentTheme = getMermaidTheme();
            if (currentTheme !== lastTheme) {
              lastTheme = currentTheme;
              restoreAndRender(mod).catch(function(error) {
                console.error('Mermaid render failed', error);
              });
            }
          });

          observer.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ['class'],
          });
        }

        function initMermaid() {
          var blocks = document.querySelectorAll('pre.mermaid');
          if (blocks.length === 0) return;

          preserveSource(blocks);

          if (mermaidModule) {
            restoreAndRender(mermaidModule).then(function() {
              setupThemeObserver(mermaidModule);
            }).catch(function(error) {
              console.error('Mermaid render failed', error);
            });
            return;
          }

          if (mermaidLoading) return;
          mermaidLoading = import(MERMAID_CDN).then(function(mod) {
            mermaidModule = mod;
            return restoreAndRender(mod).then(function() {
              setupThemeObserver(mod);
            });
          }).catch(function(error) {
            console.error('Mermaid render failed', error);
          }).finally(function() {
            mermaidLoading = null;
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initMermaid);
        } else {
          initMermaid();
        }
        document.addEventListener('astro:page-load', initMermaid);
      })();
    </script>
  </body>
</html>
