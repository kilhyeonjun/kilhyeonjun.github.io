---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../lib/utils';

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  updatedDate?: Date;
  category: string;
  tags: string[];
  readingTime: number;
  slug?: string;
}

const { title, description, publishDate, updatedDate, category, tags, readingTime, slug } = Astro.props;
const ogImage = slug ? `/og/${slug}.png` : undefined;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = ogImage ? new URL(ogImage, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: title, description, image: ogImageURL,
  datePublished: publishDate.toISOString(), ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  author: { '@type': 'Person', name: 'kilhyeonjun', url: 'https://kilhyeonjun.github.io' },
  publisher: { '@type': 'Person', name: 'kilhyeonjun' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.href }, keywords: tags.join(', '), articleSection: category,
};
const formattedDate = formatDate(publishDate);
const formattedUpdatedDate = updatedDate ? formatDate(updatedDate) : undefined;
---

<BaseLayout title={`${title} | KilPenguin Field Notes`} description={description} ogImage={ogImage} ogType="article">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article data-article-shell class="pb-10 pt-4 sm:pt-8">
    <header class="border-b border-gray-200 pb-8 dark:border-gray-700 sm:pb-10">
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.1em] text-primary-700 dark:text-primary-300">
        Field Note · <a href={`/categories/${encodeURIComponent(category)}/`} class="inline-flex min-h-11 items-center hover:underline">{category}</a>
      </p>
      <h1 class="mt-4 text-4xl font-bold leading-[1.15] tracking-[-0.045em] text-gray-950 dark:text-gray-50 sm:text-5xl">{title}</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-gray-600 dark:text-gray-300">{description}</p>
      <div class="mt-7 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-xs text-gray-500 dark:text-gray-400">
        <time datetime={publishDate.toISOString()}>{formattedDate}</time><span aria-hidden="true">·</span><span>{readingTime} min read</span>
        {formattedUpdatedDate && <><span aria-hidden="true">·</span><span>updated {formattedUpdatedDate}</span></>}
      </div>
    </header>

    <slot name="toc" />

    <div class="prose-field-notes prose prose-lg max-w-none dark:prose-invert prose-headings:tracking-tight prose-a:text-primary-700 prose-a:no-underline hover:prose-a:underline dark:prose-a:text-primary-300">
      <slot />
    </div>

    {tags.length > 0 && (
      <footer class="mt-12 border-t border-gray-200 pt-6 dark:border-gray-700">
        <p class="mb-3 font-mono text-[10px] font-semibold uppercase tracking-[0.1em] text-gray-500 dark:text-gray-400">Filed under</p>
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`} class="inline-flex min-h-11 items-center rounded-full border border-gray-200 px-3 text-sm text-gray-700 hover:border-primary-400 hover:text-primary-700 dark:border-gray-700 dark:text-gray-300 dark:hover:border-primary-500 dark:hover:text-primary-300">#{tag}</a>)}
        </div>
      </footer>
    )}

    <slot name="after-content" />
  </article>

  <style is:global>
    .prose-field-notes { color: #374151; line-height: 1.85; }
    .dark .prose-field-notes { color: #d1d5db; }
    .prose-field-notes :is(h2, h3, h4) { scroll-margin-top: 6rem; }
    .prose-field-notes h2 { margin-top: 3.5rem; border-top: 1px solid #e5e7eb; padding-top: 2rem; }
    .dark .prose-field-notes h2 { border-color: #374151; }
    .prose-field-notes :is(pre, img, table) { border-radius: 0.75rem; }
    .prose-field-notes pre { border: 1px solid #374151; box-shadow: 0 12px 32px rgba(17, 24, 39, 0.12); }
    .prose-field-notes blockquote { border-left-color: #2563eb; background: rgba(219, 234, 254, 0.35); padding: 0.75rem 1.25rem; }
    .dark .prose-field-notes blockquote { background: rgba(30, 64, 175, 0.14); }
  </style>

  <script>
    document.addEventListener('astro:page-load', () => {
      document.querySelectorAll<HTMLElement>('.prose pre').forEach((block) => {
        if (block.closest('.relative.group') || block.classList.contains('mermaid')) return;
        const wrapper = document.createElement('div'); wrapper.className = 'relative group';
        block.parentNode?.insertBefore(wrapper, block); wrapper.appendChild(block);
        const button = document.createElement('button');
        button.className = 'absolute right-2 top-2 flex min-h-11 min-w-11 items-center justify-center rounded-lg border border-gray-600 bg-gray-900/85 px-3 text-xs font-semibold text-gray-200 opacity-100 transition hover:bg-gray-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-400 sm:opacity-0 sm:group-hover:opacity-100 sm:focus:opacity-100';
        button.textContent = 'Copy'; button.type = 'button'; button.setAttribute('aria-label', '코드 복사');
        button.addEventListener('click', async () => {
          try { await navigator.clipboard.writeText(block.querySelector('code')?.textContent ?? ''); button.textContent = 'Done'; button.setAttribute('aria-label', '복사 완료'); }
          catch { button.textContent = 'Fail'; button.setAttribute('aria-label', '복사 실패'); }
          setTimeout(() => { button.textContent = 'Copy'; button.setAttribute('aria-label', '코드 복사'); }, 2000);
        });
        wrapper.appendChild(button);
      });
    });
  </script>
</BaseLayout>
