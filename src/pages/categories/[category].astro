---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveHeader from '../../components/ArchiveHeader.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getPublishedPosts, sortPostsByDate } from '../../lib/utils';

export async function getStaticPaths() {
  const allPosts = await getPublishedPosts();
  const categories = new Set(allPosts.map((post) => post.data.category));
  return [...categories].map((category) => ({ params: { category }, props: { category, posts: sortPostsByDate(allPosts.filter((post) => post.data.category === category)) } }));
}
const { category, posts } = Astro.props;
---

<BaseLayout title={`${category} | KilPenguin Field Notes`} description={`${category} 카테고리의 글 목록`} wide>
  <section class="mx-auto max-w-5xl py-6 sm:py-10">
    <ArchiveHeader eyebrow="Category" title={category} description={`${category} 맥락에서 정리한 기술 기록입니다.`} count={posts.length} countLabel="notes" />
    <div class="mt-4">{posts.map((post) => <BlogCard title={post.data.title} description={post.data.description} publishDate={post.data.publishDate} category={post.data.category} tags={post.data.tags} slug={post.id} />)}</div>
  </section>
</BaseLayout>
