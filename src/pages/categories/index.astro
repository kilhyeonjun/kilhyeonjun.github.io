---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/utils';

const allPosts = await getPublishedPosts();

const categoryCounts = new Map<string, number>();
allPosts.forEach((post) => {
  const cat = post.data.category;
  categoryCounts.set(cat, (categoryCounts.get(cat) ?? 0) + 1);
});

const sortedCategories = [...categoryCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="Categories | kil-penguin blog" description="카테고리별 글 목록">
  <section class="py-4">
    <h1 class="mb-2 text-3xl font-bold text-gray-900 dark:text-gray-100">Categories</h1>
    <p class="mb-8 text-gray-600 dark:text-gray-400">
      총 {sortedCategories.length}개의 카테고리
    </p>
    <div class="grid gap-4 sm:grid-cols-2">
      {sortedCategories.map(([category, count]) => (
        <a
          href={`/categories/${encodeURIComponent(category)}/`}
          class="flex items-center justify-between rounded-xl border border-gray-200 p-5 transition-all hover:border-primary-400 hover:shadow-md dark:border-gray-700 dark:hover:border-primary-500"
        >
          <span class="font-semibold text-gray-900 dark:text-gray-100">{category}</span>
          <span class="rounded-full bg-gray-100 px-3 py-1 text-sm font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-400">
            {count}
          </span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
