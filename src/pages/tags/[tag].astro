---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveHeader from '../../components/ArchiveHeader.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getPublishedPosts, sortPostsByDate } from '../../lib/utils';

export async function getStaticPaths() {
  const allPosts = await getPublishedPosts();
  const tags = new Set<string>();
  allPosts.forEach((post) => post.data.tags.forEach((tag) => tags.add(tag)));
  return [...tags].map((tag) => ({ params: { tag }, props: { tag, posts: sortPostsByDate(allPosts.filter((post) => post.data.tags.includes(tag))) } }));
}
const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag} | KilPenguin Field Notes`} description={`${tag} 태그의 글 목록`} wide>
  <section class="mx-auto max-w-5xl py-6 sm:py-10">
    <ArchiveHeader eyebrow="Tag" title={`#${tag}`} description={`${tag} 키워드로 연결된 기술 기록입니다.`} count={posts.length} countLabel="notes" />
    <div class="mt-4">{posts.map((post) => <BlogCard title={post.data.title} description={post.data.description} publishDate={post.data.publishDate} category={post.data.category} tags={post.data.tags} slug={post.id} />)}</div>
  </section>
</BaseLayout>
